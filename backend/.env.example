JWT_REFRESH_EXPIRES=7d
CLIENT_ORIGIN=http://localhost:5173
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=TrainMitra <onboarding@resend.dev>
GEMINI_API_KEY=your_gemini_api_key
